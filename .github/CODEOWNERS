# Directory-scoped ownership. Last matching line wins, so the catch-all is
# first and the most specific override is last.
*                            @greenlight-lab-rb/platform
/services/api/               @greenlight-lab-rb/platform
/services/web/               @greenlight-lab-rb/frontend
/infra/                      @greenlight-lab-rb/security-review
# A nested override: this one file inside a frontend-owned directory is
# owned by security instead. Last match wins, so it beats /services/web/.
/services/web/package.json   @greenlight-lab-rb/security-review
